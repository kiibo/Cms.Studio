@using Cms.Studio.Core.Domain
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Tags";
    var tags = (List<Tag>)ViewBag.Tags;
}

<div class="admin-head">
    <h1>Tags</h1>
</div>

<div class="admin-card">
    <p class="muted">Tags are created automatically when saving a post (comma separated in the "Tags" field of the post editor).</p>
    <table class="admin-table">
        <thead>
            <tr><th>Name</th><th>Slug</th><th class="col-actions">Actions</th></tr>
        </thead>
        <tbody>
            @foreach (var tag in tags)
            {
                <tr>
                    <td><strong>@tag.Name</strong></td>
                    <td><span class="slug-chip">@tag.Slug</span></td>
                    <td class="actions">
                        <form method="post" action="/admin/catalog/tags/delete/@tag.Id" class="inline"
                              onsubmit="return confirm('Delete this tag?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="icon-btn danger" title="Delete" aria-label="Delete @tag.Name">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18"/><path d="M8 6V4a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
