@using Cms.Studio.Core.Domain
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Comments";
    var comments = (List<Comment>)ViewBag.Comments;
    var postTitles = (Dictionary<int, string>)ViewBag.PostTitles;
    var keyword = (string)ViewBag.Keyword;
    var status = (string)ViewBag.Status;
}

<div class="admin-head">
    <h1>Blog comments <span class="muted">(@ViewBag.PendingCount pending)</span></h1>
    <form class="filter-form" method="get" action="/admin/comments">
        <select name="status">
            <option value="all" selected="@(status == "all" ? "selected" : null)">All</option>
            <option value="pending" selected="@(status == "pending" ? "selected" : null)">Not approved</option>
            <option value="approved" selected="@(status == "approved" ? "selected" : null)">Approved</option>
        </select>
        <input type="text" name="keyword" value="@keyword" placeholder="Search comment / name / email…" />
        <button type="submit" class="btn secondary">Search</button>
    </form>
</div>

<div class="admin-card">
    <form method="post" action="/admin/comments/action" id="comments-form">
        @Html.AntiForgeryToken()
        <input type="hidden" name="status" value="@status" />
        <input type="hidden" name="keyword" value="@keyword" />

        <div class="bulk-bar">
            <button type="submit" name="bulkAction" value="approve" class="btn">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                Approve selected
            </button>
            <button type="submit" name="bulkAction" value="disapprove" class="btn secondary">Disapprove selected</button>
            <button type="submit" name="bulkAction" value="delete" class="btn danger"
                    onclick="return confirm('Delete the selected comments?');">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18"/><path d="M8 6V4a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
                Delete selected
            </button>
        </div>

        @if (comments.Count == 0)
        {
            <p class="muted">No comments match this filter.</p>
        }
        else
        {
            <table class="admin-table">
                <thead>
                    <tr>
                        <th><input type="checkbox" id="check-all" title="Select all" /></th>
                        <th>Post</th>
                        <th>Customer</th>
                        <th>Comment</th>
                        <th>Created on</th>
                        <th>Approved</th>
                        <th class="col-actions">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var comment in comments)
                    {
                        <tr>
                            <td><input type="checkbox" name="ids" value="@comment.Id" class="row-check" /></td>
                            <td>
                                <a href="/admin/posts/edit/@comment.PostId" title="Edit post">@postTitles[comment.PostId]</a>
                            </td>
                            <td class="comment-customer">
                                <strong>@comment.NickName</strong>
                                <span class="muted">@comment.Email</span>
                            </td>
                            <td class="comment-cell">
                                @if (comment.ParentId != null)
                                {
                                    <span class="muted">(reply) </span>
                                }
                                @(comment.Content.Length > 160 ? comment.Content[..160] + "…" : comment.Content)
                            </td>
                            <td>@Ui.DateTimeShort(comment.CreatedOnUtc)</td>
                            <td>
                                @if (comment.IsApproved)
                                {
                                    <span class="pill pill-ok">Approved</span>
                                }
                                else
                                {
                                    <span class="pill pill-warn">Pending</span>
                                }
                            </td>
                            <td class="actions">
                                @if (comment.IsApproved)
                                {
                                    <button type="submit" name="single" value="disapprove:@comment.Id" class="icon-btn warn" title="Disapprove" aria-label="Disapprove comment">
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
                                    </button>
                                }
                                else
                                {
                                    <button type="submit" name="single" value="approve:@comment.Id" class="icon-btn ok" title="Approve" aria-label="Approve comment">
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                                    </button>
                                }
                                <button type="submit" name="single" value="delete:@comment.Id" class="icon-btn danger" title="Delete" aria-label="Delete comment"
                                        onclick="return confirm('Delete this comment?');">
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18"/><path d="M8 6V4a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </form>
</div>

<script>
    document.getElementById('check-all').addEventListener('change', function () {
        document.querySelectorAll('.row-check').forEach(function (cb) { cb.checked = document.getElementById('check-all').checked; });
    });
</script>
