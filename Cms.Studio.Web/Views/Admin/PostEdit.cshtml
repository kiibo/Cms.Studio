@model AdminPostEditViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = Model.Post.Id > 0 ? "Edit post" : "New post";
    ViewData["Wide"] = true;
    var isNew = Model.Post.Id == 0;
    var currentCover = Ui.CoverUrl(Model.Post);
}

<div class="admin-head">
    <h1>@(isNew ? "New post" : $"Edit post: {Model.Post.Title}")</h1>
    <div>
        @if (!isNew)
        {
            <a class="btn secondary" href="/blog/@(Model.Post.Slug)" target="_blank">View post</a>
            <a class="btn secondary" href="/blog/@(Model.Post.Slug).md" target="_blank">View Markdown</a>
        }
        <button type="submit" form="post-form" class="btn">Save</button>
        <a class="btn secondary" href="/admin/posts">Back to list</a>
    </div>
</div>

<form method="post" action="/admin/posts/edit/@(isNew ? "" : Model.Post.Id.ToString())" class="post-edit-form" id="post-form">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All"></div>

    <div class="edit-grid">
        <div class="admin-card">
            <h2>Content</h2>
            <label>Title *
                <input type="text" name="Post.Title" value="@Model.Post.Title" required />
            </label>
            <label>Summary (used in listings and as the default meta description)
                <textarea name="Post.Summary" rows="3">@Model.Post.Summary</textarea>
            </label>
            <label>Body (Markdown — paste or drag &amp; drop images to upload)</label>
            <div id="vditor-editor" class="editor-wrap"></div>
            <textarea name="Post.ContentMd" id="content-md" style="display:none">@Model.Post.ContentMd</textarea>
        </div>

        <div class="admin-card">
            <h2>Publishing</h2>
            <label>Slug (leave empty to generate from the title)
                <input type="text" name="Post.Slug" value="@Model.Post.Slug" placeholder="my-post-slug" />
            </label>
            <label>Category *
                <select name="Post.CategoryId">
                    <option value="0">— Select —</option>
                    @foreach (var category in Model.Categories)
                    {
                        <option value="@category.Id" selected="@(Model.Post.CategoryId == category.Id ? "selected" : null)">@category.Name</option>
                    }
                </select>
            </label>
            <label>Tags (comma separated)
                <input type="text" name="TagsInput" value="@Model.TagsInput" placeholder="ai, seo, dotnet" />
            </label>
            <label>Series (multi-select)
                <select name="SelectedSeriesIds" multiple size="5">
                    @foreach (var series in Model.AllSeries)
                    {
                        <option value="@series.Id" selected="@(Model.SelectedSeriesIds.Contains(series.Id) ? "selected" : null)">@series.Title</option>
                    }
                </select>
            </label>
            <label>Cover image (shown in the homepage hero &amp; feed cards)</label>
            <div class="cover-upload">
                <input type="hidden" name="Post.CoverImageUrl" id="cover-url" value="@Model.Post.CoverImageUrl" />
                <div id="cover-preview-box" style="@(string.IsNullOrEmpty(Model.Post.CoverImageUrl) ? "display:none" : null)">
                    <img id="cover-preview" class="cover-preview" src="@Model.Post.CoverImageUrl" alt="Cover preview" />
                </div>
                <div class="cover-actions">
                    <label class="btn secondary cover-pick">
                        Upload image<input type="file" id="cover-file" accept="image/*" />
                    </label>
                    <button type="button" class="btn secondary" id="cover-remove">Remove</button>
                </div>
                <p class="cover-hint" id="cover-status">No cover chosen. Leave empty to use the first image inside the post body automatically.</p>
            </div>
            <label>Status
                <select name="Post.Status">
                    <option value="0" selected="@(Model.Post.Status == PostStatus.Draft ? "selected" : null)">Draft</option>
                    <option value="1" selected="@(Model.Post.Status == PostStatus.Published ? "selected" : null)">Published</option>
                </select>
            </label>
            <label class="check">
                <input type="checkbox" name="Post.IsFixedTop" value="true" checked="@(Model.Post.IsFixedTop ? "checked" : null)" />
                Pin to top (shown first on the home feed and in rankings)
            </label>
            <label>Publish date (UTC — leave empty to use the current time on publish)
                <input type="datetime-local" name="Post.PublishedOnUtc"
                       value="@(Model.Post.PublishedOnUtc?.ToString("yyyy-MM-ddTHH:mm"))" />
            </label>

            <h2>SEO</h2>
            <label>Meta title (leave empty to use the post title)
                <input type="text" name="Post.MetaTitle" value="@Model.Post.MetaTitle" />
            </label>
            <label>Meta description (leave empty to use the summary)
                <textarea name="Post.MetaDescription" rows="2">@Model.Post.MetaDescription</textarea>
            </label>

            <button type="submit" class="btn">Save</button>
        </div>
    </div>
</form>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/vditor@3.8.15/dist/index.css" 
      crossorigin="anonymous" />
<script src="https://cdn.jsdelivr.net/npm/vditor@3.8.15" 
        crossorigin="anonymous"></script>
<script>
(function () {
    // Check if Vditor is loaded
    let attempts = 0;
    const maxAttempts = 100; // 10 seconds max

    function tryInit() {
        if (typeof Vditor === 'undefined') {
            attempts++;
            if (attempts < maxAttempts) {
                setTimeout(tryInit, 100);
                return;
            }
            console.error('Vditor failed to load from CDN');
            return;
        }

        initEditor();
    }

    function initEditor() {
        const mdField = document.getElementById('content-md');
        const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
        const csrfToken = tokenInput ? tokenInput.value : '';

        const initialContent = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Post.ContentMd ?? string.Empty));

        try {
            const vditor = new Vditor('vditor-editor', {
                lang: 'en_US',
                mode: 'ir',
                height: Math.max(560, window.innerHeight - 300),
                cache: { enable: false },
                after: function () {
                    vditor.setValue(initialContent);
                },
                counter: { enable: true, type: 'markdown' },
                resize: { enable: true },
                toolbarConfig: { pin: true },
                toolbar: [
                    'headings', 'bold', 'italic', 'strike', 'link', '|',
                    'list', 'ordered-list', 'check', '|',
                    'quote', 'code', 'inline-code', 'table', '|',
                    'upload', '|',
                    'undo', 'redo', '|',
                    'edit-mode', 'preview', 'outline', 'fullscreen'
                ],
                preview: {
                    markdown: { toc: true },
                    hljs: { enable: true, style: 'github' }
                },
                upload: {
                    url: '/admin/upload/image',
                    fieldName: 'file',
                    accept: 'image/*',
                    max: 10 * 1024 * 1024,
                    headers: { 'X-XSRF-TOKEN': csrfToken },
                    format: function (files, responseText) {
                        try {
                            const resp = JSON.parse(responseText);
                            return JSON.stringify({ msg: '', code: 0, data: { fileUrls: [resp.url] } });
                        } catch (e) {
                            return JSON.stringify({ msg: 'Upload failed', code: 1, data: { fileUrls: [] } });
                        }
                    }
                }
            });

            // Sync to hidden field on form submit
            const form = document.querySelector('form.post-edit-form');
            form.addEventListener('submit', function () {
                mdField.value = vditor.getValue();
            });
        } catch (error) {
            console.error('Failed to initialize Vditor:', error);
        }
    }

    // Start initialization
    tryInit();

    // Cover image upload handling
    const coverUrl = document.getElementById('cover-url');
    const coverFile = document.getElementById('cover-file');
    const coverPreviewBox = document.getElementById('cover-preview-box');
    const coverPreview = document.getElementById('cover-preview');
    const coverStatus = document.getElementById('cover-status');
    const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
    const csrfToken = tokenInput ? tokenInput.value : '';

    if (coverFile) {
        coverFile.addEventListener('change', async function () {
            const file = coverFile.files[0];
            if (!file) return;

            coverStatus.textContent = 'Uploading…';
            const body = new FormData();
            body.append('file', file);

            try {
                const resp = await fetch('/admin/upload/image', {
                    method: 'POST',
                    body: body,
                    headers: { 'X-XSRF-TOKEN': csrfToken }
                });
                const data = await resp.json().catch(function () { return {}; });
                if (resp.ok && data.url) {
                    coverUrl.value = data.url;
                    coverPreview.src = data.url;
                    coverPreviewBox.style.display = '';
                    coverStatus.textContent = 'Uploaded: ' + data.url;
                } else {
                    coverStatus.textContent = 'Upload failed: ' + (data.error || resp.status);
                }
            } catch (e) {
                coverStatus.textContent = 'Upload failed: ' + e.message;
            }
            coverFile.value = '';
        });
    }

    if (document.getElementById('cover-remove')) {
        document.getElementById('cover-remove').addEventListener('click', function () {
            coverUrl.value = '';
            coverPreview.removeAttribute('src');
            coverPreviewBox.style.display = 'none';
            coverStatus.textContent = 'No cover chosen. Leave empty to use the first image inside the post body automatically.';
        });
    }
})();
</script>
