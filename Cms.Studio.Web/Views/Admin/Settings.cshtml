@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Settings";
}

<div class="admin-head">
    <h1>Site settings</h1>
</div>

@if (ViewBag.UsingDefaultPassword == true)
{
    <div class="admin-card narrow" style="border-left: 4px solid #d33;">
        <p class="error"><strong>Security warning:</strong> the admin account still uses the default password.
            Change it below before someone else does.</p>
    </div>
}

<div class="admin-card narrow">
    @if (TempData["Saved"] != null)
    {
        <p class="success">Settings saved.</p>
    }
    <form method="post" action="/admin/settings">
        @Html.AntiForgeryToken()
        <label>Site title
            <input type="text" name="siteTitle" value="@ViewBag.SiteTitle" />
        </label>
        <label>Site description (used for meta descriptions and llms.txt)
            <textarea name="siteDescription" rows="3">@ViewBag.SiteDescription</textarea>
        </label>
        <label>Site base URL (used for canonical URLs / sitemap / RSS, e.g. https://example.com)
            <input type="text" name="siteBaseUrl" value="@ViewBag.SiteBaseUrl" />
        </label>
        <label>Posts per page
            <input type="number" name="postsPerPage" value="@ViewBag.PostsPerPage" min="1" max="100" />
        </label>
        <label>Default author name
            <input type="text" name="authorName" value="@ViewBag.AuthorName" />
        </label>
        <label>Article display template
            <select name="articleTemplate">
                <option value="classic" selected="@(ViewBag.ArticleTemplate == "classic" ? "selected" : null)">Classic — original site style (with reading presets below)</option>
                <option value="huashu" selected="@(ViewBag.ArticleTemplate == "huashu" ? "selected" : null)">Huashu — editorial magazine style (serif, drop cap, § sections)</option>
            </select>
        </label>
        <label>Article reading style (Classic template only)
            <select name="articleStyle">
                @foreach (var opt in new[] { ("default", "Default — current site typography"), ("comfy", "Comfy — serif, airy line height for long reads"), ("paper", "Paper — warm sepia page, easy on the eyes"), ("large", "Large — extra-big type for relaxed reading") })
                {
                    <option value="@opt.Item1" selected="@(ViewBag.ArticleStyle == opt.Item1 ? "selected" : null)">@opt.Item2</option>
                }
            </select>
        </label>
        <button type="submit" class="btn">Save</button>
    </form>
</div>

<div class="admin-card narrow">
    <h2>Brand &amp; logo</h2>

    @if (TempData["BrandSaved"] != null)
    {
        <p class="success">Brand settings saved.</p>
    }
    @if (TempData["BrandError"] != null)
    {
        <p class="error">@TempData["BrandError"]</p>
    }

    <form method="post" action="/admin/settings/brand" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <label>Brand text (shown in the header next to the logo)
            <input type="text" name="brandText" value="@ViewBag.BrandText" maxlength="50" />
        </label>
        <label>Logo image (optional)
            <input type="file" name="logo" accept=".jpg,.jpeg,.png,.gif,.webp,.avif,.bmp" />
        </label>
        <p class="muted">No image needed: when no logo is uploaded (or the current one is removed), the header
            keeps using the classic <strong>CMS.STUDIO</strong> text logo with the default mark. You can update the
            brand text alone — uploading a picture is never required. Leave the text blank to restore the default
            "Cms.Studio".</p>
        @if (!string.IsNullOrEmpty(ViewBag.SiteLogo))
        {
            <div class="logo-preview">
                <img src="@ViewBag.SiteLogo" alt="current logo" />
                <label class="inline"><input type="checkbox" name="removeLogo" value="true" /> Remove current logo</label>
            </div>
        }
        <button type="submit" class="btn">Save brand</button>
    </form>
</div>

<div class="admin-card narrow">
    <h2>API access</h2>
    <p class="muted">For AI agents / automations that publish articles without the admin UI.
        Send the token as <code>Authorization: Bearer *** or <code>X-Api-Key</code>.
        Endpoints: <code>GET /api/catalog</code>, <code>GET /api/posts</code>,
        <code>GET /api/posts/{idOrSlug}</code>, <code>POST /api/posts</code>,
        <code>PUT /api/posts/{id}</code>, <code>POST /api/images</code> (multipart),
        <code>POST /api/images/base64</code>.</p>
    @if (TempData["TokenSaved"] != null)
    {
        <p class="success">A new API token has been generated. Update your integrations — the old token no longer works.</p>
    }
    <label>API token
        <input type="text" value="@ViewBag.ApiToken" readonly onclick="this.select();" />
    </label>
    <form method="post" action="/admin/settings/api-token">
        @Html.AntiForgeryToken()
        <input type="hidden" name="regenerate" value="true" />
        <button type="submit" class="btn secondary" onclick="return confirm('Regenerate the token? Existing integrations must use the new one.');">Regenerate token</button>
    </form>
</div>

<div class="admin-card narrow">
    <h2>Security</h2>

    @if (TempData["PasswordSaved"] != null)
    {
        <p class="success">Password changed.</p>
    }
    @if (TempData["PasswordError"] != null)
    {
        <p class="error">@TempData["PasswordError"]</p>
    }

    <form method="post" action="/admin/settings/security">
        @Html.AntiForgeryToken()
        <label>Current password
            <input type="password" name="currentPassword" autocomplete="current-password" required />
        </label>
        <label>New password (10+ characters)
            <input type="password" name="newPassword" autocomplete="new-password" required />
        </label>
        <label>Repeat new password
            <input type="password" name="confirmPassword" autocomplete="new-password" required />
        </label>
        <button type="submit" class="btn">Change password</button>
    </form>
</div>
