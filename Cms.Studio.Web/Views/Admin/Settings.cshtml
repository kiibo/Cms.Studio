@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Settings";
}

<div class="admin-head">
    <h1>Site settings</h1>
</div>

<div class="admin-card narrow">
    @if (TempData["Saved"] != null)
    {
        <p class="success">Settings saved.</p>
    }
    <form method="post" action="/admin/settings">
        @Html.AntiForgeryToken()
        <label>Site title
            <input type="text" name="siteTitle" value="@ViewBag.SiteTitle" />
        </label>
        <label>Site description (used for meta descriptions and llms.txt)
            <textarea name="siteDescription" rows="3">@ViewBag.SiteDescription</textarea>
        </label>
        <label>Site base URL (used for canonical URLs / sitemap / RSS, e.g. https://example.com)
            <input type="text" name="siteBaseUrl" value="@ViewBag.SiteBaseUrl" />
        </label>
        <label>Posts per page
            <input type="number" name="postsPerPage" value="@ViewBag.PostsPerPage" min="1" max="100" />
        </label>
        <label>Default author name
            <input type="text" name="authorName" value="@ViewBag.AuthorName" />
        </label>
        <button type="submit" class="btn">Save</button>
    </form>
</div>
