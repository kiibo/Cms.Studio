@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Settings";
}

<div class="admin-head">
    <h1>Site settings</h1>
</div>

@if (ViewBag.UsingDefaultPassword == true)
{
    <div class="admin-card narrow" style="border-left: 4px solid #d33;">
        <p class="error"><strong>Security warning:</strong> the admin account still uses the default password.
            Change it below before someone else does.</p>
    </div>
}

<div class="admin-card narrow">
    @if (TempData["Saved"] != null)
    {
        <p class="success">Settings saved.</p>
    }
    <form method="post" action="/admin/settings">
        @Html.AntiForgeryToken()
        <label>Site title
            <input type="text" name="siteTitle" value="@ViewBag.SiteTitle" />
        </label>
        <label>Site description (used for meta descriptions and llms.txt)
            <textarea name="siteDescription" rows="3">@ViewBag.SiteDescription</textarea>
        </label>
        <label>Site base URL (used for canonical URLs / sitemap / RSS, e.g. https://example.com)
            <input type="text" name="siteBaseUrl" value="@ViewBag.SiteBaseUrl" />
        </label>
        <label>Posts per page
            <input type="number" name="postsPerPage" value="@ViewBag.PostsPerPage" min="1" max="100" />
        </label>
        <label>Default author name
            <input type="text" name="authorName" value="@ViewBag.AuthorName" />
        </label>
        <button type="submit" class="btn">Save</button>
    </form>
</div>

<div class="admin-card narrow">
    <h2>Brand &amp; logo</h2>

    @if (TempData["BrandSaved"] != null)
    {
        <p class="success">Brand settings saved.</p>
    }
    @if (TempData["BrandError"] != null)
    {
        <p class="error">@TempData["BrandError"]</p>
    }

    <form method="post" action="/admin/settings/brand" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <label>Brand text (shown in the header next to the logo)
            <input type="text" name="brandText" value="@ViewBag.BrandText" maxlength="50" />
        </label>
        <label>Logo image (optional — jpg / png / webp / gif, shown instead of the default mark)
            <input type="file" name="logo" accept=".jpg,.jpeg,.png,.gif,.webp,.avif,.bmp" />
        </label>
        @if (!string.IsNullOrEmpty(ViewBag.SiteLogo))
        {
            <div class="logo-preview">
                <img src="@ViewBag.SiteLogo" alt="current logo" />
                <label class="inline"><input type="checkbox" name="removeLogo" value="true" /> Remove current logo</label>
            </div>
        }
        <button type="submit" class="btn">Save brand</button>
    </form>
</div>

<div class="admin-card narrow">
    <h2>Security</h2>

    @if (TempData["PasswordSaved"] != null)
    {
        <p class="success">Password changed.</p>
    }
    @if (TempData["PasswordError"] != null)
    {
        <p class="error">@TempData["PasswordError"]</p>
    }

    <form method="post" action="/admin/settings/security">
        @Html.AntiForgeryToken()
        <label>Current password
            <input type="password" name="currentPassword" autocomplete="current-password" required />
        </label>
        <label>New password (10+ characters)
            <input type="password" name="newPassword" autocomplete="new-password" required />
        </label>
        <label>Repeat new password
            <input type="password" name="confirmPassword" autocomplete="new-password" required />
        </label>
        <button type="submit" class="btn">Change password</button>
    </form>
</div>
