@using Cms.Studio.Core.Domain
@using Cms.Studio.Core.Services
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Posts";
    var posts = (PagedResult<Post>)ViewBag.Posts;
}

<div class="admin-head">
    <h1>Posts</h1>
    <a class="btn" href="/admin/posts/edit">New post</a>
</div>

<form class="filter-form" method="get" action="/admin/posts">
    <input type="text" name="keyword" value="@ViewBag.Keyword" placeholder="Search by title" />
    <select name="status">
        <option value="">All statuses</option>
        <option value="0" selected="@((ViewBag.Status as PostStatus?) == PostStatus.Draft ? "selected" : null)">Draft</option>
        <option value="1" selected="@((ViewBag.Status as PostStatus?) == PostStatus.Published ? "selected" : null)">Published</option>
    </select>
    <button type="submit" class="btn">Search</button>
</form>

<div class="admin-card">
    <table class="admin-table">
        <thead>
            <tr>
                <th>Title</th>
                <th>Category</th>
                <th>Status</th>
                <th>Pinned</th>
                <th>Views</th>
                <th>Published on</th>
                <th class="col-actions">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var post in posts.Items)
            {
                <tr>
                    <td><a href="/blog/@post.Slug" target="_blank"><strong>@post.Title</strong></a></td>
                    <td>
                        @if (post.Category != null)
                        {
                            <span class="pill">@post.Category.Name</span>
                        }
                    </td>
                    <td>
                        @if (post.Status == PostStatus.Published)
                        {
                            <span class="pill pill-ok">Published</span>
                        }
                        else
                        {
                            <span class="pill pill-warn">Draft</span>
                        }
                    </td>
                    <td>
                        @if (post.IsFixedTop)
                        {
                            <span class="pill pill-accent">Top</span>
                        }
                    </td>
                    <td>@post.ViewCount</td>
                    <td>@Ui.Date(post.PublishedOnUtc ?? post.CreatedOnUtc)</td>
                    <td class="actions">
                        <a class="icon-btn" href="/admin/posts/edit/@post.Id" title="Edit" aria-label="Edit @post.Title">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>
                        </a>
                        <form method="post" action="/admin/posts/delete/@post.Id" class="inline"
                              onsubmit="return confirm('Delete this post?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="icon-btn danger" title="Delete" aria-label="Delete @post.Title">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18"/><path d="M8 6V4a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <partial name="_Paging" model="posts" />
</div>
