@using Cms.Studio.Core.Domain
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Categories";
    var categories = (List<Category>)ViewBag.Categories;
}

<div class="admin-head">
    <h1>Categories</h1>
</div>

<div class="edit-grid">
    <div class="admin-card">
        <h2>Add / edit category</h2>
        <form method="post" action="/admin/catalog/categories/save">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Id" value="0" />
            <label>Name *
                <input type="text" name="Name" required />
            </label>
            <label>Description
                <textarea name="Description" rows="2"></textarea>
            </label>
            <label>Slug (leave empty to generate from the name)
                <input type="text" name="Slug" />
            </label>
            <label>Display order
                <input type="number" name="DisplayOrder" value="0" />
            </label>
            <label class="check">
                <input type="checkbox" name="ShowOnMenu" value="true" checked="checked" />
                Show in the navigation menu
            </label>
            <button type="submit" class="btn">Save</button>
        </form>
    </div>

    <div class="admin-card">
        <h2>All categories (@categories.Count)</h2>
        <table class="admin-table">
            <thead>
                <tr><th>Name</th><th>Slug</th><th>Order</th><th>In menu</th><th>Actions</th></tr>
            </thead>
            <tbody>
                @foreach (var category in categories)
                {
                    <tr>
                        <td>@category.Name</td>
                        <td>@category.Slug</td>
                        <td>@category.DisplayOrder</td>
                        <td>@(category.ShowOnMenu ? "Yes" : "No")</td>
                        <td class="actions">
                            <form method="post" action="/admin/catalog/categories/delete/@category.Id" class="inline"
                                  onsubmit="return confirm('Delete this category?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="link-btn">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
