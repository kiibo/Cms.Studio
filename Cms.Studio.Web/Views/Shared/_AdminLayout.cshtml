@{
    var siteTitle = ViewData["Title"] as string ?? "Cms.Studio";
    var path = Context.Request.Path.Value ?? string.Empty;
    bool Active(string prefix) => path.StartsWith(prefix, StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] != null ? ViewData["Title"] + " — " : "")Cms.Studio Admin</title>
    <link rel="stylesheet" href="/css/site.css" />
</head>
<body class="console-body">
    <div class="console-shell">
        <aside class="console-side">
            <a class="console-brand" href="/"><span class="brand-mark"></span>Cms.Studio</a>
            <button class="nav-toggle console-toggle" type="button" aria-label="Toggle navigation" aria-expanded="false" aria-controls="console-menu">
                <span class="nav-toggle-bar"></span>
                <span class="nav-toggle-bar"></span>
                <span class="nav-toggle-bar"></span>
            </button>
            <div class="console-menu" id="console-menu">
                <nav class="console-nav">
                    <span class="console-group">Manage</span>
                    <a class="@(Active("/admin") && !Active("/admin/posts") && !Active("/admin/comments") && !Active("/admin/catalog") && !Active("/admin/settings") ? "on" : "")" href="/admin/dashboard"><span class="nav-ic">@Html.Raw(Ui.AdminIcon("dashboard"))</span>Dashboard</a>
                    <a class="@(Active("/admin/posts") ? "on" : "")" href="/admin/posts"><span class="nav-ic">@Html.Raw(Ui.AdminIcon("posts"))</span>Posts</a>
                    <a class="@(Active("/admin/comments") ? "on" : "")" href="/admin/comments"><span class="nav-ic">@Html.Raw(Ui.AdminIcon("comments"))</span>Comments</a>
                    <span class="console-group">Catalog</span>
                    <a class="@(Active("/admin/catalog/categories") ? "on" : "")" href="/admin/catalog/categories"><span class="nav-ic">@Html.Raw(Ui.AdminIcon("categories"))</span>Categories</a>
                    <a class="@(Active("/admin/catalog/series") ? "on" : "")" href="/admin/catalog/series"><span class="nav-ic">@Html.Raw(Ui.AdminIcon("series"))</span>Series</a>
                    <a class="@(Active("/admin/catalog/tags") ? "on" : "")" href="/admin/catalog/tags"><span class="nav-ic">@Html.Raw(Ui.AdminIcon("tags"))</span>Tags</a>
                    <span class="console-group">System</span>
                    <a class="@(Active("/admin/settings") ? "on" : "")" href="/admin/settings"><span class="nav-ic">@Html.Raw(Ui.AdminIcon("settings"))</span>Settings</a>
                </nav>
                <div class="console-side-foot">
                    <a href="/" target="_blank">View site ↗</a>
                    <a href="/admin/logout">Sign out</a>
                </div>
            </div>
        </aside>

        <div class="console-main">
            <header class="console-top">
                <span class="console-crumb">Admin / @siteTitle</span>
                <a class="console-user" href="/admin/settings">admin</a>
            </header>
            <main class="admin-main @(ViewData["Wide"] != null ? "admin-main-wide" : "")">
                @RenderBody()
            </main>
        </div>
    </div>
    @await RenderSectionAsync("Scripts", required: false)
    <script>
        (function () {
            var side = document.querySelector('.console-side');
            var toggle = document.querySelector('.console-toggle');
            if (!side || !toggle) return;
            function setOpen(open) {
                side.classList.toggle('nav-open', open);
                toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
            }
            toggle.addEventListener('click', function (e) {
                e.stopPropagation();
                setOpen(!side.classList.contains('nav-open'));
            });
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') setOpen(false);
            });
            document.addEventListener('click', function (e) {
                if (!side.contains(e.target)) setOpen(false);
            });
            window.addEventListener('resize', function () {
                if (window.innerWidth > 900) setOpen(false);
            });
        })();
    </script>
</body>
</html>
