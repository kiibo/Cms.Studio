{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // nopCommerce-style provider selection: SqlServer | MySql | PostgreSQL | Sqlite
  "DataProvider": {
    "ProviderName": "Sqlite",
    "ConnectionString": "Data Source=cmsstudio.db"
    // MySql example:
    // "ProviderName": "MySql",
    // "ConnectionString": "Server=localhost;Database=cmsstudio;User=root;Password=secret;",
    // "MySqlServerVersion": "8.0.36-mysql"
  },

  "AdminAccount": {
    "Username": "admin",
    "Password": "change-me"
  },

  // Comment verification codes are e-mailed to the commenter. Leave Host empty to
  // disable sending - in the Development environment the code is then shown on the
  // page so the flow can be tested without a mail server.
  "Smtp": {
    "Host": "",
    "Port": 587,
    "UserName": "",
    "Password": "",
    "From": "",
    "EnableSsl": true
  }
}
